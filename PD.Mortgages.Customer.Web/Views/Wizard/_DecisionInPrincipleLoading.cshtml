@model bool
<div class="dip-loading" role="status" aria-live="polite">
    @if (Model)
    {
        <span class="spinner-border text-primary" aria-hidden="true"></span>
    }
    <div>
        <strong>@(Model ? "Running a simulated credit check…" : "Preparing your result without a credit check…")</strong>
        <p class="mb-0">@(Model ? "This usually takes a few seconds. No credit agency or lender is contacted." : "No credit agency or lender is contacted.")</p>
    </div>
</div>
