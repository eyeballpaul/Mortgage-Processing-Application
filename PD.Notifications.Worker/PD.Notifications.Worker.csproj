  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <InternalsVisibleTo Include="PD.Mortgages.Tests" />
    <Compile Include="..\PD.Shared\SubmissionMessage.cs" Link="SubmissionMessage.cs" />
    <Compile Include="..\PD.Shared\NotificationServiceBus.cs" Link="NotificationServiceBus.cs" />
  </ItemGroup>
</Project>
