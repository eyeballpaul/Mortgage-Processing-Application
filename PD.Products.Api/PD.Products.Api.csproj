<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <Compile Include="..\PD.Shared\RequestTelemetryMiddleware.cs" Link="RequestTelemetryMiddleware.cs" />
    <Compile Include="..\PD.Shared\TracingRegistration.cs" Link="TracingRegistration.cs" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="8.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\PD.Products.Application\PD.Products.Application.csproj" />
	<ProjectReference Include="..\PD.Products.Contracts\PD.Products.Contracts.csproj" />
	<ProjectReference Include="..\PD.Products.Infrastructure\PD.Products.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
	<TargetFramework>net11.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
