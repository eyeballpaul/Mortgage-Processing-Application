@model PD.Mortgages.Application.Models.MortgageApplicationDto
@{
    ViewData["Title"] = "Decision in Principle";
    ViewData["WizardStep"] = 5;
    var hasResult = Model.DecisionInPrinciple is not null;
}
<div class="form-card">
    <p class="eyebrow">Step 5 · Decision in Principle</p>
    <h1>Your indicative borrowing guide</h1>
    <p class="text-secondary">Here’s a simple guide based on the details you’ve shared so far.</p>

    <div id="dip-assessment"
         data-assessment-url="@Url.Action("AssessDecisionInPrinciple", "Wizard")"
         data-credit-check-consented="@Model.CreditCheckConsent.ToString().ToLowerInvariant()"
         data-needs-assessment="@(!hasResult ? "true" : "false")"
         aria-live="polite">
        @if (Model.DecisionInPrinciple is not null)
        {
            @await Html.PartialAsync("_DecisionInPrincipleResult", Model)
        }
        else
        {
            @await Html.PartialAsync("_DecisionInPrincipleLoading", Model.CreditCheckConsent)
        }
    </div>
    <form id="dip-antiforgery" class="visually-hidden">
        @Html.AntiForgeryToken()
    </form>

    <div class="form-actions mt-4">
        <a class="btn btn-outline-secondary btn-lg" asp-action="Connections">Back</a>
        <a class="text-link" asp-action="Qualification">Review property and deposit</a>
        <form action="/application/decision-in-principle" method="post">
            @Html.AntiForgeryToken()
            <button id="continue-to-mortgages" type="submit" class="btn btn-primary btn-lg" disabled="@(!hasResult)">Continue to mortgages <span aria-hidden="true">→</span></button>
        </form>
    </div>
    <div class="start-over-row">@await Html.PartialAsync("_StartOver")</div>
</div>

@section Scripts {
    <script src="~/js/decision-in-principle.js" asp-append-version="true"></script>
}
