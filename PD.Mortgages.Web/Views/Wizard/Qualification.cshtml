@model QualificationViewModel
@{
    ViewData["Title"] = "Your plans";
    ViewData["WizardStep"] = 1;
}
<div class="form-card">
    <p class="eyebrow">A few details to get started</p>
    <h1>Tell us about your plans</h1>
    <p class="text-secondary">This helps us show you mortgage options that could fit your plans. Your estimate is not an offer of credit.</p>
    <form asp-action="Qualification" method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="mb-4">
            <label asp-for="PropertyValue" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true">£</span>
                <input asp-for="PropertyValue" class="form-control" inputmode="decimal" placeholder="300,000" />
            </div>
            <span asp-validation-for="PropertyValue" class="field-validation"></span>
            <div class="form-text">The price of the home you’re hoping to buy.</div>
        </div>
        <div class="mb-4">
            <label asp-for="Deposit" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true">£</span>
                <input asp-for="Deposit" class="form-control" inputmode="decimal" placeholder="30,000" />
            </div>
            <span asp-validation-for="Deposit" class="field-validation"></span>
            <div class="form-text">Your deposit can include savings and other funds available for the purchase.</div>
        </div>
        <div class="form-actions">
            <span class="secure-note"><span aria-hidden="true">●</span> Your information is private</span>
            <button type="submit" class="btn btn-primary btn-lg">Continue <span aria-hidden="true">→</span></button>
        </div>
    </form>
</div>
