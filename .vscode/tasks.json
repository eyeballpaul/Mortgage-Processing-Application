{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/PD.Mortgages.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run Aspire AppHost",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/PD.Mortgages.AppHost/PD.Mortgages.AppHost.csproj",
        "--launch-profile",
        "https"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/Applications/Docker.app/Contents/Resources/bin:${env:PATH}"
        }
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
